{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SignatureForge Users",
  "type": "object",
  "required": ["users"],
  "properties": {
    "version": { "type": "integer" },
    "updated": { "type": "string" },
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["email", "template", "fields"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "template": { "type": "string" },
          "fields": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    }
  }
}
